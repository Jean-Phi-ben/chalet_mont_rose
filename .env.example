# Copiez ce fichier en `.env` (développement) et renseignez les valeurs.
# En production, les mêmes clés vivent dans ~/.chalet_env sur le serveur.
# Le `.env` réel est ignoré par git : ne jamais le committer.

# --- Connexion Google (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Administrateurs (accès /admin) ---
# Liste blanche des adresses email, séparées par des virgules. Vide = aucun admin.
ADMIN_EMAILS=

# --- Identité de la société (contrat, factures, mentions légales, emails) ---
COMPANY_LEGAL_NAME=Chalet Mont Rose SARL
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VAT_NUMBER=
COMPANY_CAPITAL=
COMPANY_RCS=
COMPANY_REPRESENTATIVE=
COMPANY_EMAIL=chaletmontrose74@gmail.com
COMPANY_PHONE=+33 6 89 06 40 57
# Médiateur de la consommation (obligatoire pour un professionnel)
MEDIATOR_NAME=
MEDIATOR_ADDRESS=
MEDIATOR_URL=
# Mentions légales
HOSTING_PROVIDER=
TOURISM_REGISTRATION_NUMBER=

# --- Coordonnées bancaires (RIB sur les factures) ---
COMPANY_ACCOUNT_HOLDER=
COMPANY_IBAN=
COMPANY_BIC=

# --- Tarification ---
# Part d'arrhes (fraction du prix d'hébergement), 0.30 par défaut.
DEPOSIT_RATE=0.30

# --- Emails (SMTP Gmail, mot de passe d'application) ---
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
# Obligatoire en production (démarrage refusé sinon).
MAILER_FROM=Chalet Mont Rose <exemple@gmail.com>
MAILER_OWNER_EMAIL=

# --- Swikly (caution en ligne) ---
# En production, sans ces clés aucune caution n'est demandée (le rappel part sans lien).
SWIKLY_API_KEY=
SWIKLY_ACCOUNT_ID=
SWIKLY_API_SECRET=
SWIKLY_CALLBACK_URL=
# Sandbox Swikly : true en développement ; en production, false (défaut) sauf test explicite.
SWIKLY_TEST_MODE=true
# Montant de la caution en euros (sinon 30 % du séjour, entre 500 et 2 000 €).
CAUTION_AMOUNT=1000
# Jours de maintien de l'empreinte après le départ.
CAUTION_HOLD_DAYS=7

# --- Staging (même serveur que la prod) ---
# STAGING=true : emails non envoyés, Swikly en mode test, HTTPS non forcé.
