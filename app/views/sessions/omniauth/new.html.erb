<% content_for :title, "Connexion — Chalet Mont Rose" %>

<div class="max-w-md mx-auto mt-6 sm:mt-12">
  <div class="bg-white border border-stone-200 rounded-2xl p-8 shadow-sm">
    <div class="text-center mb-7">
      <%= image_tag "/logo.png", alt: "Chalet Mont Rose", class: "mx-auto mb-3 h-20 w-auto" %>
      <h1 class="text-2xl font-serif text-stone-900" style="font-family: 'Playfair Display', serif;">Espace client</h1>
      <p class="text-sm text-stone-500 mt-1">Connectez-vous pour gérer votre séjour.</p>
    </div>

    <%# --- Connexion email / mot de passe --- %>
    <%= form_with url: session_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "Email", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= f.email_field :email_address, autocomplete: "email", required: true,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <div>
        <%= f.label :password, "Mot de passe", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
        <div class="text-right mt-1.5">
          <%= link_to "Mot de passe oublié ?", new_password_path, class: "text-xs text-stone-400 hover:text-stone-700" %>
        </div>
      </div>
      <%= f.submit "Se connecter", class: "w-full bg-stone-900 text-white py-2.5 rounded-xl text-sm uppercase tracking-widest hover:bg-stone-800 transition cursor-pointer" %>
    <% end %>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 border-t border-stone-200"></div>
      <span class="text-xs text-stone-400 uppercase tracking-widest">ou</span>
      <div class="flex-1 border-t border-stone-200"></div>
    </div>

    <%# --- Connexion Google --- %>
    <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
          class: "w-full flex items-center justify-center gap-3 border border-stone-300 rounded-xl px-4 py-3 hover:bg-stone-50 transition cursor-pointer" do %>
      <i class="fa-brands fa-google text-lg"></i>
      <span class="text-sm font-medium text-stone-700">Se connecter avec Google</span>
    <% end %>

    <p class="text-sm text-stone-500 text-center mt-7">
      Pas encore de compte ?
      <%= link_to "Créer un compte", signup_path, class: "text-stone-900 font-medium underline hover:text-stone-700" %>
    </p>
  </div>
</div>
