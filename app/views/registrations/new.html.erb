<% content_for :title, "Créer un compte — Chalet Mont Rose" %>

<div class="max-w-md mx-auto mt-6 sm:mt-12">
  <div class="bg-white border border-stone-200 rounded-2xl p-8 shadow-sm">
    <div class="text-center mb-7">
      <i class="fa-solid fa-user-plus text-3xl text-stone-300 mb-3"></i>
      <h1 class="text-2xl font-serif text-stone-900" style="font-family: 'Playfair Display', serif;">Créer un compte</h1>
      <p class="text-sm text-stone-500 mt-1">Accédez à votre espace : contrat, factures et documents.</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with model: @user, url: signup_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "Email", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= f.email_field :email_address, autocomplete: "email", required: true,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <div>
        <%= f.label :password, "Mot de passe", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <%= f.submit "Créer mon compte", class: "w-full bg-stone-900 text-white py-2.5 rounded-xl text-sm uppercase tracking-widest hover:bg-stone-800 transition cursor-pointer" %>
    <% end %>

    <p class="text-sm text-stone-500 text-center mt-7">
      Vous avez déjà un compte ?
      <%= link_to "Se connecter", login_path, class: "text-stone-900 font-medium underline hover:text-stone-700" %>
    </p>
  </div>
</div>
