<%# Texte du contrat — rendu depuis les mêmes sections que le texte canonique haché
    (ContractTemplate.sections) : ce que le client lit est ce qui est signé. %>
<% sections = ContractTemplate.sections(booking, contract) %>

<header class="mb-6">
  <h2 class="text-xl font-serif text-stone-900" style="font-family: 'Playfair Display', serif;">
    Contrat de location saisonnière — <%= CompanyIdentity.legal_name %>
  </h2>
  <p class="text-[11px] text-stone-400 uppercase tracking-widest mt-1">Version du contrat : <%= ContractTemplate::VERSION %></p>
</header>

<% sections.each do |section| %>
  <section class="mb-5" data-contract-section="<%= section.number %>">
    <h3 class="font-semibold text-stone-900 mb-2"><%= section.number %>. <%= section.title %></h3>
    <%= contract_body_html(section.body) %>
  </section>
<% end %>
