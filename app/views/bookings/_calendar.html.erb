<% max_height ||= "60vh" %>
<%# months_html : mois déjà rendus (render coûteux : une requête de tarif par jour), pour
    afficher le même calendrier deux fois sur une page sans le recalculer. %>
<% months_html ||= nil %>

<div class="bg-white border border-stone-200 rounded-2xl overflow-hidden">
  <div class="overflow-y-auto" style="max-height: <%= max_height %>;" data-calendar-scroller>
    <div class="sticky top-0 bg-white border-b border-stone-100 px-4 sm:px-6 py-3 z-10" data-calendar-header>
      <div class="flex justify-end mb-2">
        <button type="button" data-action="click->calendar#scrollToToday"
                class="inline-flex items-center gap-1.5 text-xs text-stone-600 border border-stone-200 rounded-full px-3 py-1 hover:border-stone-400 hover:text-stone-900 transition">
          <i class="fa-solid fa-calendar-day text-stone-400"></i> Aujourd'hui
        </button>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-[11px] uppercase tracking-widest text-stone-400">
        <% %w[L M M J V S D].each do |d| %><div><%= d %></div><% end %>
      </div>
    </div>

    <div class="px-4 sm:px-6 py-4 space-y-8">
      <% if months_html %>
        <%= months_html %>
      <% else %>
        <% calendar_months.each do |m| %>
          <%= render "bookings/month", month: m %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
