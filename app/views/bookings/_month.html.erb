<% start_day  = month.beginning_of_month.beginning_of_week(:monday) %>
<% last_day   = month.end_of_month.end_of_week(:monday) %>
<% availability = Booking.availability_between(start_day, last_day) %>
<% blocked    = availability[:blocked] %>
<% transition = availability[:transition] %>
<% rates      = Pricing.nightly_cents_by_date(start_day, last_day) %>

<div data-calendar-month>
  <p class="font-serif text-lg text-stone-900 capitalize text-center mb-3" id="month-<%= month.strftime("%Y-%m") %>"><%= fr_month_year(month) %></p>

  <div class="grid grid-cols-7 gap-1" role="group" aria-labelledby="month-<%= month.strftime("%Y-%m") %>">
    <% (start_day..last_day).each do |day| %>
      <% in_month       = day.month == month.month %>
      <% nightly        = rates[day] %>
      <% past           = day < Date.current %>
      <% today          = in_month && day == Date.current %>
      <% fully_blocked  = blocked.include?(day) %>
      <% is_transition  = transition.include?(day) && !fully_blocked %>
      <% clickable      = in_month && !past && !fully_blocked %>
      <% status = if fully_blocked
                    "déjà réservé"
                  elsif past
                    "passé"
                  elsif is_transition
                    "arrivée ou départ possible ce jour-là"
                  elsif clickable && !day.saturday? && day.beginning_of_week(:saturday) < Date.current
                    "semaine en cours déjà commencée, arrivée le samedi suivant"
                  elsif clickable && !day.saturday?
                    "le samedi de cette semaine sera retenu"
                  elsif clickable
                    "arrivée ou départ possible"
                  end %>
      <% tooltip = status&.sub(/\A./, &:upcase) %>
      <% label  = [ fr_date_full(day), (nightly && clickable ? "#{money(nightly)} la nuit" : nil), status ].compact.join(", ") %>
      <% classes = [ "relative aspect-square rounded-lg p-1 flex flex-col items-center justify-center text-center select-none border w-full",
                     in_month ? "border-stone-100" : "border-transparent opacity-30",
                     ("cursor-pointer hover:border-stone-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-900" if clickable),
                     ("bg-stone-100" if fully_blocked && in_month),
                     ("cal-today" if today) ].compact.join(" ") %>
      <% if in_month %>
        <button type="button" class="<%= classes %>"
                data-calendar-target="day" data-date="<%= day.iso8601 %>"
                <% if today %>data-today aria-current="date"<% end %>
                <% if clickable %>data-action="click->calendar#pick"<% else %>disabled<% end %>
                aria-label="<%= label %>" title="<%= tooltip %>">
          <% if is_transition %>
            <%# Bandeau gradient diagonal qui indique la transition (chalet libre une demi-journée) %>
            <span class="absolute inset-0 rounded-lg pointer-events-none"
                  style="background: linear-gradient(135deg, #f5f5f4 0%, #f5f5f4 50%, transparent 50%, transparent 100%);"></span>
          <% end %>
          <span class="relative text-xs <%= fully_blocked ? 'line-through decoration-2 decoration-stone-500 text-stone-500' : (past ? 'text-stone-400 line-through' : 'text-stone-700') %>"><%= day.day %></span>
          <% if nightly && clickable %>
            <span class="relative text-[10px] text-stone-500 leading-none mt-0.5"><%= money(nightly) %></span>
          <% end %>
        </button>
      <% else %>
        <div class="<%= classes %>" aria-hidden="true"><span class="relative text-xs text-stone-400"><%= day.day %></span></div>
      <% end %>
    <% end %>
  </div>
</div>
