<% content_for :title, "Tableau de bord — Admin" %>

<div class="mb-8">
  <h1 class="text-2xl font-serif text-stone-900 tracking-wide" style="font-family: 'Playfair Display', serif;">
    Tableau de bord
  </h1>
  <p class="text-sm text-stone-500 mt-1">Aperçu et pense-bête.</p>
</div>

<% card      = "bg-white border border-stone-200 rounded-2xl overflow-hidden" %>
<% card_head = "flex items-center justify-between gap-4 px-5 py-4 border-b border-stone-100" %>
<% card_h2   = "text-base font-serif text-stone-900" %>
<% row_link  = "flex items-center justify-between gap-4 px-5 py-3 hover:bg-stone-50 transition" %>
<% more_link = "text-[11px] text-stone-500 hover:text-stone-900 uppercase tracking-widest shrink-0" %>

<%# ───── Réservations à valider ───── %>
<section class="<%= card %> mb-6" data-dashboard-section="pending-bookings">
  <div class="<%= card_head %>">
    <div class="flex items-center gap-2.5">
      <i class="fa-solid fa-hourglass-half text-amber-500"></i>
      <h2 class="<%= card_h2 %>" style="font-family: 'Playfair Display', serif;">Réservations à valider</h2>
      <% if @pending_bookings.any? %>
        <span class="text-[11px] px-2 py-0.5 rounded-full border bg-amber-50 text-amber-700 border-amber-200"><%= @pending_bookings.size %></span>
      <% end %>
    </div>
    <%= link_to admin_bookings_path(status: "pending"), class: more_link do %>
      Toutes <i class="fa-solid fa-arrow-right ml-1"></i>
    <% end %>
  </div>

  <% if @pending_bookings.any? %>
    <div class="divide-y divide-stone-100">
      <% @pending_bookings.each do |booking| %>
        <%= link_to admin_booking_path(booking), class: row_link do %>
          <div class="min-w-0">
            <p class="text-sm font-medium text-stone-900 truncate"><%= booking.full_name %></p>
            <p class="text-xs text-stone-500">
              <%= fr_date(booking.check_in) %> → <%= fr_date(booking.check_out) %>
              · <%= pluralize(booking.guests_count.to_i, "voyageur") %>
              · demandée le <%= fr_date(booking.created_at.to_date) %>
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-sm text-stone-900"><%= money(booking.total_price_cents) %></span>
            <span class="text-[11px] uppercase tracking-widest text-stone-500">Examiner <i class="fa-solid fa-chevron-right ml-0.5"></i></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="px-5 py-6 text-sm text-stone-400 text-center">Aucune demande en attente.</p>
  <% end %>
</section>

<%# ───── Factures : à venir / encaissées ───── %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <section class="<%= card %>" data-dashboard-section="upcoming-invoices">
    <div class="<%= card_head %>">
      <div class="flex items-center gap-2.5">
        <i class="fa-regular fa-clock text-stone-400"></i>
        <h2 class="<%= card_h2 %>" style="font-family: 'Playfair Display', serif;">Factures à venir</h2>
      </div>
      <span class="text-sm text-stone-900"><%= money(@upcoming_invoices.sum(&:amount_cents)) %></span>
    </div>

    <% if @upcoming_invoices.any? %>
      <div class="divide-y divide-stone-100">
        <% @upcoming_invoices.each do |invoice| %>
          <%= link_to admin_invoice_path(invoice), class: row_link do %>
            <div class="min-w-0">
              <p class="text-sm text-stone-900 truncate">
                <span class="font-medium"><%= invoice.label %></span> · <%= invoice.booking.full_name %>
              </p>
              <p class="text-xs text-stone-500"><%= invoice.number %> · facture du <%= fr_date(invoice.issued_on) %></p>
              <% if invoice.overdue? %>
                <p class="text-xs text-red-700 font-medium mt-0.5" data-invoice-state="overdue">
                  <i class="fa-solid fa-circle-exclamation mr-0.5"></i> En retard — échéance <%= fr_date(invoice.due_on) %>
                </p>
              <% else %>
                <p class="text-xs text-amber-700 mt-0.5" data-invoice-state="awaiting">
                  À régler au plus tard le <%= fr_date(invoice.due_on) %>
                </p>
              <% end %>
            </div>
            <span class="text-sm text-stone-900 shrink-0"><%= money(invoice.amount_cents) %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="px-5 py-6 text-sm text-stone-400 text-center">Aucune facture en attente de paiement.</p>
    <% end %>
  </section>

  <section class="<%= card %>" data-dashboard-section="received-invoices">
    <div class="<%= card_head %>">
      <div class="flex items-center gap-2.5">
        <i class="fa-solid fa-circle-check text-emerald-500"></i>
        <h2 class="<%= card_h2 %>" style="font-family: 'Playfair Display', serif;">Factures encaissées</h2>
      </div>
      <span class="text-sm text-stone-900" title="Total encaissé"><%= money(@received_total_cents) %></span>
    </div>

    <% if @received_invoices.any? %>
      <div class="divide-y divide-stone-100">
        <% @received_invoices.each do |invoice| %>
          <%= link_to admin_invoice_path(invoice), class: row_link do %>
            <div class="min-w-0">
              <p class="text-sm text-stone-900 truncate">
                <span class="font-medium"><%= invoice.label %></span> · <%= invoice.booking.full_name %>
              </p>
              <p class="text-xs text-stone-500"><%= invoice.number %> · facture du <%= fr_date(invoice.issued_on) %></p>
              <p class="text-xs text-emerald-700 mt-0.5" data-invoice-state="paid">Payée le <%= fr_date(invoice.received_on) %></p>
            </div>
            <span class="text-sm text-stone-900 shrink-0"><%= money(invoice.amount_cents) %></span>
          <% end %>
        <% end %>
      </div>
      <%= link_to admin_invoices_path, class: "block px-5 py-3 border-t border-stone-100 #{more_link} text-center" do %>
        Toutes les factures <i class="fa-solid fa-arrow-right ml-1"></i>
      <% end %>
    <% else %>
      <p class="px-5 py-6 text-sm text-stone-400 text-center">Aucune facture encaissée pour l'instant.</p>
    <% end %>
  </section>
</div>

<%= render "admin/notes/box", notes: @notes, note: @note %>
