<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Admin — Chalet Mont Rose" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400&display=swap" rel="stylesheet">
    <%= render "shared/font_awesome" %>
  </head>

  <body class="bg-stone-100 min-h-screen" style="font-family: 'Lato', sans-serif;">
    <!-- Barre admin -->
    <header class="bg-white border-b border-stone-200 sticky top-0 z-40" data-controller="navbar">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <%= link_to admin_root_path, class: "flex items-center gap-2 shrink-0" do %>
          <span class="text-base sm:text-lg tracking-[0.15em] uppercase text-stone-800 font-light" style="font-family: 'Playfair Display', serif;">
            Chalet Mont Rose
          </span>
          <span class="text-[10px] uppercase tracking-widest bg-stone-900 text-white px-2 py-0.5 rounded-full">Admin</span>
        <% end %>

        <%# Navigation horizontale — visible à partir de lg %>
        <nav class="hidden lg:flex items-center gap-6 text-xs tracking-widest uppercase text-stone-500">
          <%= link_to "Tableau de bord", admin_root_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Réservations", admin_bookings_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Factures", admin_invoices_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Tarifs", admin_weekly_rates_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Documents", admin_documents_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Emails", admin_email_logs_path, class: "hover:text-stone-900 transition" %>
          <%= link_to "Paramètres", admin_booking_setting_path, class: "hover:text-stone-900 transition" %>
        </nav>

        <%# Actions de droite — visibles à partir de lg : retour au site + même menu que le site public %>
        <div class="hidden lg:flex items-center gap-2 shrink-0">
          <%# Texte masqué entre lg et xl : la barre (logo + 7 liens) est déjà pleine. %>
          <%= link_to root_path, title: "Voir le site", aria: { label: "Voir le site" },
                class: "inline-flex items-center gap-2 border border-stone-300 rounded-full px-3 xl:px-4 h-9 text-xs uppercase tracking-widest text-stone-700 hover:bg-stone-100 hover:text-stone-900 transition" do %>
            <i class="fa-solid fa-house"></i><span class="hidden xl:inline">Voir le site</span>
          <% end %>

          <div class="relative" data-controller="usermenu"
               data-action="click@window->usermenu#closeOnOutside keydown.esc@window->usermenu#close">
            <button type="button"
                    class="inline-flex items-center justify-center gap-2 rounded-full px-3 h-10 text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition"
                    aria-haspopup="menu" aria-expanded="false" aria-label="Menu"
                    data-usermenu-target="button"
                    data-action="click->usermenu#toggle">
              <i class="fa-solid fa-house-chimney text-lg"></i>
              <i class="fa-solid fa-chevron-down text-xs opacity-60 transition-transform" data-usermenu-target="chevron"></i>
            </button>

            <div class="hidden absolute right-0 mt-2 w-64 max-h-[80vh] overflow-y-auto bg-white shadow-lg rounded-xl border border-stone-100 p-2 z-50"
                 role="menu" data-usermenu-target="menu">
              <%= render "shared/main_menu" %>
            </div>
          </div>
        </div>

        <%# Burger — visible en dessous de lg %>
        <button type="button"
                data-navbar-target="toggle"
                data-action="click->navbar#toggle"
                aria-controls="admin-mobile-menu"
                aria-expanded="false"
                aria-label="Ouvrir le menu"
                class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-stone-700 hover:bg-stone-100 transition">
          <i data-navbar-target="iconOpen"  class="fa-solid fa-bars text-lg"></i>
          <i data-navbar-target="iconClose" class="fa-solid fa-xmark text-lg" style="display:none"></i>
        </button>
      </div>

      <%# Menu mobile (volet déroulant) — caché par défaut, ouvert via Stimulus %>
      <div id="admin-mobile-menu"
           data-navbar-target="menu"
           class="hidden lg:hidden border-t border-stone-200 bg-white">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col gap-1 text-sm">
          <%= link_to root_path, class: "flex items-center justify-center gap-2 mb-2 py-3 rounded-xl bg-stone-900 text-white text-xs uppercase tracking-widest hover:bg-stone-800 transition" do %>
            <i class="fa-solid fa-house"></i> Retour au site
          <% end %>
          <% mobile_link_class = "block py-2.5 px-3 rounded-lg text-stone-700 hover:bg-stone-100 transition" %>
          <%= link_to "Tableau de bord", admin_root_path,           class: mobile_link_class %>
          <%= link_to "Réservations",    admin_bookings_path,       class: mobile_link_class %>
          <%= link_to "Factures",        admin_invoices_path,       class: mobile_link_class %>
          <%= link_to "Tarifs",          admin_weekly_rates_path,   class: mobile_link_class %>
          <%= link_to "Documents",       admin_documents_path,      class: mobile_link_class %>
          <%= link_to "Emails",          admin_email_logs_path,     class: mobile_link_class %>
          <%= link_to "Paramètres",      admin_booking_setting_path, class: mobile_link_class %>

          <div class="border-t border-stone-200 mt-2 pt-3 flex items-center justify-between gap-3">
            <%= link_to root_path(anchor: "disponibilites"), class: "text-xs text-stone-500 hover:text-stone-900 transition" do %>
              <i class="fa-solid fa-calendar-days mr-1"></i> Disponibilités &amp; tarifs
            <% end %>
            <% if authenticated? %>
              <%= button_to session_path, method: :delete, class: "text-xs text-red-600 hover:text-red-700 transition" do %>
                <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Déconnexion
              <% end %>
            <% end %>
          </div>
        </nav>
      </div>
    </header>

    <% if (missing = missing_company_settings).any? %>
      <div class="bg-red-600 text-white" role="alert" data-company-settings-alert>
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 text-sm flex items-start gap-3">
          <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
          <p>
            <strong>Coordonnées de la société manquantes sur le serveur :</strong> <%= missing.to_sentence %>.
            Les factures et contrats générés maintenant seront incomplets (RIB ou mentions légales absents).
            À renseigner dans les variables <code class="font-mono text-xs">COMPANY_*</code> du serveur.
          </p>
        </div>
      </div>
    <% end %>

    <%= render "shared/flashes" %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
