<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Espace client — Chalet Mont Rose" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="apple-touch-icon" href="/logo.png">
    <%# Font Awesome dans une couche CSS « fa » sous Tailwind (cf. layout application). %>
    <style>@import url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css") layer(fa);</style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-50 min-h-screen flex flex-col">
    <%# Même en-tête que le site public (logo, menu maison, burger) : retour au site en un clic,
        et rubrique Administration pour les comptes administrateurs. %>
    <%= render "shared/navbar" %>

    <%# Onglets de l'espace client (la déconnexion est dans le menu maison / burger). %>
    <div class="bg-white border-b border-stone-200">
      <% link_base = "flex items-center gap-2 px-3 py-2 rounded-lg whitespace-nowrap" %>
      <% active = "bg-stone-100 text-stone-900" %>
      <% idle   = "text-stone-600 hover:text-stone-900 hover:bg-stone-50" %>
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 py-2 flex items-center gap-1 text-sm overflow-x-auto" aria-label="Espace client">
        <%= link_to account_root_path, class: "#{link_base} #{current_page?(account_root_path) ? active : idle}" do %>
          <i class="fa-solid fa-gauge opacity-70"></i><span>Tableau de bord</span>
        <% end %>
        <%= link_to account_profile_path, class: "#{link_base} #{current_page?(account_profile_path) ? active : idle}" do %>
          <i class="fa-solid fa-user opacity-70"></i><span>Mon profil</span>
        <% end %>
        <%= link_to account_documents_path, class: "#{link_base} #{current_page?(account_documents_path) ? active : idle}" do %>
          <i class="fa-solid fa-folder-open opacity-70"></i><span>Documents</span>
        <% end %>
      </nav>
    </div>

    <%= render "shared/flashes" %>

    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 py-5 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-400" aria-label="Pages légales">
        <%= link_to "Mentions légales", legal_path, class: "hover:text-stone-700" %>
        <%= link_to "Conditions générales de location", terms_path, class: "hover:text-stone-700" %>
        <%= link_to "Politique de confidentialité", privacy_path, class: "hover:text-stone-700" %>
      </nav>
    </footer>
  </body>
</html>
