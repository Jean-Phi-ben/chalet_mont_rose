<%# Menu unifié, rendu dans le dropdown desktop et le menu mobile.
    Socle « Grand public » toujours présent ; + pages espace client si connecté ;
    + catégorie « Administration » si admin. %>
<% item = "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-stone-700 hover:bg-stone-50 transition" %>
<% cat  = "px-3 pt-3 pb-1 text-[10px] text-stone-400 uppercase tracking-widest" %>

<% if authenticated? %>
  <div class="px-3 pb-2 mb-1 border-b border-stone-100">
    <p class="text-[10px] text-stone-400 uppercase tracking-widest">Connecté</p>
    <p class="text-sm font-medium text-stone-900 truncate"><%= Current.user.email_address %></p>
  </div>
<% end %>

<%# ───── Catégorie : Grand public ───── %>
<p class="<%= cat %>">Grand public</p>
<%= link_to root_path, class: item do %>
  <i class="fa-solid fa-house w-4 text-center opacity-70"></i> Accueil
<% end %>
<%= link_to calendar_path, class: item do %>
  <i class="fa-solid fa-calendar-days w-4 text-center opacity-70"></i> Disponibilités &amp; tarifs
<% end %>
<% if authenticated? %>
  <%= link_to account_root_path, class: item do %>
    <i class="fa-solid fa-calendar-check w-4 text-center opacity-70"></i> Mes réservations
  <% end %>
  <%= link_to account_profile_path, class: item do %>
    <i class="fa-solid fa-user w-4 text-center opacity-70"></i> Mon profil
  <% end %>
  <%= link_to account_documents_path, class: item do %>
    <i class="fa-solid fa-folder-open w-4 text-center opacity-70"></i> Documents
  <% end %>
<% end %>

<% if authenticated? && Current.user.admin? %>
  <%# ───── Catégorie : Administration (admin uniquement) ───── %>
  <p class="<%= cat %> mt-1 border-t border-stone-100">Administration</p>
  <%= link_to admin_root_path, class: item do %>
    <i class="fa-solid fa-gauge w-4 text-center opacity-70"></i> Tableau de bord
  <% end %>
  <%= link_to admin_weekly_rates_path, class: item do %>
    <i class="fa-solid fa-tags w-4 text-center opacity-70"></i> Tarifs
  <% end %>
  <%= link_to admin_bookings_path, class: item do %>
    <i class="fa-solid fa-calendar-check w-4 text-center opacity-70"></i> Réservations
  <% end %>
  <%= link_to admin_invoices_path, class: item do %>
    <i class="fa-solid fa-file-invoice w-4 text-center opacity-70"></i> Factures
  <% end %>
  <%= link_to admin_documents_path, class: item do %>
    <i class="fa-solid fa-folder-tree w-4 text-center opacity-70"></i> Documents (admin)
  <% end %>
  <%= link_to admin_email_logs_path, class: item do %>
    <i class="fa-solid fa-envelope w-4 text-center opacity-70"></i> Emails
  <% end %>
  <%= link_to admin_booking_setting_path, class: item do %>
    <i class="fa-solid fa-sliders w-4 text-center opacity-70"></i> Paramètres
  <% end %>
<% end %>

<div class="my-1 border-t border-stone-100"></div>
<% if authenticated? %>
  <%= button_to session_path, method: :delete, class: "#{item} w-full text-red-600 hover:bg-red-50" do %>
    <i class="fa-solid fa-arrow-right-from-bracket w-4 text-center"></i> Déconnexion
  <% end %>
<% else %>
  <%= link_to login_path, class: item do %>
    <i class="fa-solid fa-right-to-bracket w-4 text-center opacity-70"></i> Se connecter
  <% end %>
<% end %>
