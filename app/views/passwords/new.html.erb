<% content_for :title, "Mot de passe oublié — Chalet Mont Rose" %>

<div class="max-w-md mx-auto mt-6 sm:mt-12">
  <div class="bg-white border border-stone-200 rounded-2xl p-8 shadow-sm">
    <div class="text-center mb-7">
      <i class="fa-solid fa-key text-3xl text-stone-300 mb-3"></i>
      <h1 class="text-2xl font-serif text-stone-900" style="font-family: 'Playfair Display', serif;">Mot de passe oublié</h1>
      <p class="text-sm text-stone-500 mt-1">Indiquez votre adresse email : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>
    </div>

    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <%= form.submit "Envoyer le lien", class: "w-full bg-stone-900 text-white py-2.5 rounded-xl text-sm uppercase tracking-widest hover:bg-stone-800 transition cursor-pointer" %>
    <% end %>

    <p class="text-sm text-stone-500 text-center mt-7">
      <%= link_to "Retour à la connexion", login_path, class: "text-stone-900 font-medium underline hover:text-stone-700" %>
    </p>
  </div>
</div>
