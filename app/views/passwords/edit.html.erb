<% content_for :title, "Nouveau mot de passe — Chalet Mont Rose" %>

<div class="max-w-md mx-auto mt-6 sm:mt-12">
  <div class="bg-white border border-stone-200 rounded-2xl p-8 shadow-sm">
    <div class="text-center mb-7">
      <i class="fa-solid fa-key text-3xl text-stone-300 mb-3"></i>
      <h1 class="text-2xl font-serif text-stone-900" style="font-family: 'Playfair Display', serif;">Nouveau mot de passe</h1>
      <p class="text-sm text-stone-500 mt-1">Au moins <%= User::PASSWORD_MIN_LENGTH %> caractères.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, "Nouveau mot de passe", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirmer le mot de passe", class: "block text-[11px] text-stone-400 uppercase tracking-widest mb-1.5" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72,
              class: "w-full border border-stone-200 rounded-lg px-3 py-2.5 text-sm text-stone-700 focus:outline-none focus:border-stone-900 transition" %>
      </div>
      <%= form.submit "Enregistrer", class: "w-full bg-stone-900 text-white py-2.5 rounded-xl text-sm uppercase tracking-widest hover:bg-stone-800 transition cursor-pointer" %>
    <% end %>
  </div>
</div>
